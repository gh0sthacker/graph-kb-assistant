[Unit]
Description=Graph KB Assistant continuous Caido-to-graph synchronization
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=simple
User=max
Group=max
Environment=HOME=/home/max
Environment=XDG_DATA_HOME=/home/max/.local/share
EnvironmentFile=/home/max/.local/share/bb-graph-assistant/neo4j.env
EnvironmentFile=/home/max/.local/share/bb-graph-assistant/caido-sync.env
WorkingDirectory=/home/max/bb/graph-kb-assistant
ExecStart=/usr/local/bin/bb-assistant caido-sync --data-root ${BB_ASSISTANT_DATA_HOME} --instance-id ${BB_ASSISTANT_CAIDO_INSTANCE_ID} --mcp-command ${BB_ASSISTANT_CAIDO_MCP_COMMAND} --mcp-sha256 ${BB_ASSISTANT_CAIDO_MCP_SHA256} --token-file ${BB_ASSISTANT_CAIDO_TOKEN_FILE} --poll-interval 30s --missing-confirmations 3 --backfill-page-size 25 --backfill-body-limit 65536 --backfill-pages 1 --backfill-delay 250ms --tail-pages 1 --page-size 25 --body-limit 65536 --require-scope
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
UMask=0077
MemoryMax=2G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/max/.local/share/bb-graph-assistant/graph-kb-assistant
ReadOnlyPaths=/home/max/bb/graph-kb-assistant /usr/local/bin/bb-assistant /usr/local/bin/caido-mcp-server

[Install]
WantedBy=multi-user.target
