# Install as /home/max/.local/share/bb-graph-assistant/caido-sync.env and chmod 0600.
# The companion neo4j.env supplies BB_ASSISTANT_DATA_HOME and Neo4j credentials.
# Keep the token in a separate 0600 file inside BB_ASSISTANT_DATA_HOME/caido-mcp/.
# Use one stable local name for this Caido instance; never put a token value here.
BB_ASSISTANT_CAIDO_INSTANCE_ID=caido-primary
BB_ASSISTANT_CAIDO_MCP_COMMAND=/usr/local/bin/caido-mcp-server
BB_ASSISTANT_CAIDO_MCP_SHA256=5236620c693f973d5725133c660ca0ac852796dd75e02ce1993bd66202d0b04c
BB_ASSISTANT_CAIDO_TOKEN_FILE=/home/max/.local/share/bb-graph-assistant/graph-kb-assistant/caido-mcp/token.json
CAIDO_URL=http://caido.myzone.su:8080
# Comma-separated exact authorized origins. Repeated --scope-origin arguments
# are also supported. The service fails closed if this variable is empty.
BB_ASSISTANT_CAIDO_SCOPE_ORIGINS=https://demo.example.invalid:443
