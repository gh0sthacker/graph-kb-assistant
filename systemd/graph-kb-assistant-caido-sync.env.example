# Install as /etc/bb-graph-assistant/caido-sync.env and chmod 0600.
# Use one stable local name for this Caido instance; never put a token value here.
BB_ASSISTANT_CAIDO_INSTANCE_ID=desktop-caido
BB_ASSISTANT_CAIDO_MCP_COMMAND=/usr/local/bin/caido-mcp-server
BB_ASSISTANT_CAIDO_MCP_SHA256=5236620c693f973d5725133c660ca0ac852796dd75e02ce1993bd66202d0b04c
BB_ASSISTANT_CAIDO_TOKEN_FILE=/etc/bb-graph-assistant/caido-token.json
CAIDO_URL=http://caido.myzone.su:8080
BB_ASSISTANT_CAIDO_SCOPE_SCHEME=https
BB_ASSISTANT_CAIDO_SCOPE_HOST=demo.example.invalid
BB_ASSISTANT_CAIDO_SCOPE_PORT=443
