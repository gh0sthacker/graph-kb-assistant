[Unit]
Description=BB Graph Assistant Caido live intake for project %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=simple
User=bbassist
Group=bbassist
WorkingDirectory=/opt/bb-graph-assistant
EnvironmentFile=/etc/bb-graph-assistant/runtime.env
EnvironmentFile=/etc/bb-graph-assistant/caido-tail.env
ExecStart=/opt/bb-graph-assistant/bin/bb-assistant caido-tail --project-key %i --data-root /var/lib/bb-graph-assistant/data --mcp-command ${BB_ASSISTANT_CAIDO_MCP_COMMAND} --mcp-sha256 ${BB_ASSISTANT_CAIDO_MCP_SHA256} --token-file ${BB_ASSISTANT_CAIDO_TOKEN_FILE} --page-size 50 --max-pages 1 --watch --poll-interval 10s --overlap-seconds 90 --body-limit 262144
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
UMask=0077
MemoryMax=768M
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/bb-graph-assistant/data
ReadOnlyPaths=/etc/bb-graph-assistant /var/lib/bb-graph-assistant/.caido-mcp

[Install]
WantedBy=multi-user.target
