[Unit]
Description=Graph KB Assistant web application
After=network-online.target neo4j.service
Wants=network-online.target

[Service]
Type=simple
User=bbassist
Group=bbassist
WorkingDirectory=/opt/bb-graph-assistant
Environment=HOME=/var/lib/bb-graph-assistant
Environment=XDG_DATA_HOME=/var/lib/bb-graph-assistant/.local/share
Environment=BB_ASSISTANT_BINARY=/usr/local/bin/bb-assistant
Environment=BB_ASSISTANT_NEO4J_ENV_FILE=/var/lib/bb-graph-assistant/neo4j.env
Environment=BB_ASSISTANT_KB_INDEX=/var/lib/bb-graph-assistant/kb/index.sqlite3
Environment=BB_ASSISTANT_KB_SOURCE_MANIFEST=/opt/bb-graph-assistant/src/bb_assistant/kb/sources.yaml
Environment=BB_ASSISTANT_KB_MODELS=1
Environment=BB_ASSISTANT_KB_PYTHON=/var/lib/bb-graph-assistant/kb-models-venv/bin/python
Environment=PYTHONPATH=/opt/bb-graph-assistant/src
EnvironmentFile=/var/lib/bb-graph-assistant/service.env
ExecStart=/opt/bb-graph-assistant/scripts/bb-assistant serve --addr 127.0.0.1:8765 --project-key=${BB_ASSISTANT_PROJECT_KEY}
Restart=on-failure
RestartSec=5
CPUQuota=150%
MemoryMax=4G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
