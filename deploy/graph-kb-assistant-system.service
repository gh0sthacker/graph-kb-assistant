[Unit]
Description=Graph KB Assistant web application
After=network-online.target neo4j.service
Wants=network-online.target

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max/bb/graph-kb-assistant
Environment=HOME=/home/max
Environment=XDG_DATA_HOME=/home/max/.local/share
Environment=BB_ASSISTANT_BINARY=/usr/local/bin/bb-assistant
Environment=BB_ASSISTANT_NEO4J_ENV_FILE=/home/max/.local/share/bb-graph-assistant/neo4j.env
Environment=BB_ASSISTANT_KB_INDEX=/home/max/.local/share/bb-graph-assistant/kb/index.sqlite3
Environment=BB_ASSISTANT_KB_SOURCE_MANIFEST=/home/max/bb/graph-kb-assistant/src/bb_assistant/kb/sources.yaml
Environment=BB_ASSISTANT_KB_MODELS=1
Environment=PYTHONPATH=/home/max/bb/graph-kb-assistant/src
EnvironmentFile=/home/max/.local/share/bb-graph-assistant/service.env
ExecStart=/home/max/bb/graph-kb-assistant/scripts/bb-assistant serve --addr 127.0.0.1:8765 --project-key=${BB_ASSISTANT_PROJECT_KEY}
Restart=on-failure
RestartSec=5
CPUQuota=150%
MemoryMax=4G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
